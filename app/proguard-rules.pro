# Kotlinx serialization
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.AnnotationsKt
-keepclassmembers class kotlinx.serialization.json.** { *** Companion; }
-keepclasseswithmembers class kotlinx.serialization.json.** { kotlinx.serialization.KSerializer serializer(...); }
-keep,includedescriptorclasses class com.maslarski.sudoku.**$$serializer { *; }
-keepclassmembers class com.maslarski.sudoku.** { *** Companion; }
-keepclasseswithmembers class com.maslarski.sudoku.** { kotlinx.serialization.KSerializer serializer(...); }

# Readable crash stack traces in Play Console (mapping.txt is uploaded with the bundle).
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# Firestore documents are read/written as Map<String, Any> (no reflective POJO mapping), Room DAOs/entities are
# generated by KSP, and Play Billing / Firebase ship their own consumer rules, so no further keeps are needed.
