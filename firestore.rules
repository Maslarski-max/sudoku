rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidCategory(category) {
      return category.matches('^(9|12|15|18)_(EASY|MEDIUM|HARD)$');
    }

    // ScoringRules maximum: 369 Samurai cells × 30 base points × (1 entry + 1 combo + 1 maximum time bonus) × Hard ×2 = 66,420.
    function perGameMax() {
      return 66420;
    }

    function currentArenaPeriod() {
      let month = request.time.month();
      return string(request.time.year()) + '-' + (month < 10 ? '0' : '') + string(month);
    }

    function currentChampionshipPeriod() {
      return string(request.time.year());
    }

    function isTournamentScore(data, uid) {
      return data.keys().hasOnly(['uid', 'displayName', 'points', 'games', 'updatedAt'])
        && data.keys().hasAll(['uid', 'displayName', 'points', 'games', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid == uid
        && data.displayName is string && data.displayName.size() <= 32
        && data.points is int && data.games is int
        && data.updatedAt == request.time;
    }

    function canCreateTournamentScore(data, uid, period, currentPeriod) {
      return isSignedIn() && isTournamentScore(data, uid)
        && period == currentPeriod
        && data.games == 1
        && data.points >= 0 && data.points <= perGameMax();
    }

    function canUpdateTournamentScore(data, uid, period, currentPeriod) {
      return isSignedIn() && isTournamentScore(data, uid)
        && period == currentPeriod
        && resource.data.uid == request.auth.uid
        && resource.data.games is int && resource.data.points is int
        && data.games == resource.data.games + 1
        && data.points - resource.data.points >= 0
        && data.points - resource.data.points <= perGameMax();
    }

    function isValidScore(data, category) {
      return data.keys().hasOnly(['uid', 'displayName', 'gridSize', 'difficulty', 'timeMillis', 'moves', 'mistakes', 'points', 'completedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 32
        && data.gridSize is int && data.gridSize in [9, 12, 15, 18]
        && data.difficulty is string && data.difficulty in ['EASY', 'MEDIUM', 'HARD']
        && (string(data.gridSize) + '_' + data.difficulty) == category
        && data.timeMillis is int && data.timeMillis > 0 && data.timeMillis < 86400000
        && data.moves is int && data.moves >= 0 && data.moves < 100000
        && data.mistakes is int && data.mistakes >= 0 && data.mistakes < 100000
        && data.points is int && data.points >= 0 && data.points < 10000000
        && data.completedAt == request.time;
    }

    // Ranking: points desc, then timeMillis asc, then moves asc (mirrors Score.compareTo).
    function improves(next, prev) {
      return next.points > prev.points
        || (next.points == prev.points && next.timeMillis < prev.timeMillis)
        || (next.points == prev.points && next.timeMillis == prev.timeMillis && next.moves < prev.moves);
    }

    // One document per player per category; only the owner may write, and only to improve.
    match /leaderboards/{category}/scores/{uid} {
      allow read: if isSignedIn() && isValidCategory(category);

      allow create: if isSignedIn() && uid == request.auth.uid
        && isValidCategory(category)
        && isValidScore(request.resource.data, category);

      allow update: if isSignedIn() && uid == request.auth.uid
        && isValidCategory(category)
        && isValidScore(request.resource.data, category)
        && improves(request.resource.data, resource.data);

      allow delete: if false;
    }

    match /arena/{period}/scores/{uid} {
      allow read: if isSignedIn() && period.matches('^\\d{4}-\\d{2}$');
      allow create: if canCreateTournamentScore(request.resource.data, uid, period, currentArenaPeriod());
      allow update: if canUpdateTournamentScore(request.resource.data, uid, period, currentArenaPeriod());
      allow delete: if false;
    }

    match /championship/{period}/scores/{uid} {
      allow read: if isSignedIn() && period.matches('^\\d{4}$');
      allow create: if canCreateTournamentScore(request.resource.data, uid, period, currentChampionshipPeriod());
      allow update: if canUpdateTournamentScore(request.resource.data, uid, period, currentChampionshipPeriod());
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
